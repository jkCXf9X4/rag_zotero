# Required for OpenAI embeddings
OPENAI_API_KEY=

# Optional: evaluate retrieval relevance via OpenRouter (used by `rag-zotero query --eval`)
OPENROUTER_API_KEY=
OPENROUTER_EVAL_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=rag-zotero

# Optional overrides
OPENAI_EMBED_MODEL=text-embedding-3-small
# Set this to a Hugging Face model id or a local directory downloaded with
# scripts/download_sentence_transformer.sh
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-mpnet-base-v2
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=zotero

# Indexing defaults
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
